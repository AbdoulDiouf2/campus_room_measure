[Unit]
Description=CampusData development ingestion worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/maadec/infra/aivancity-dev
ExecStart=/home/maadec/infra/aivancity-dev/scripts/run-worker-dev.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
